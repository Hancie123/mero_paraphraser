{
  "name": "mero_paraphraser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "python -m unittest discover -s python-engine/tests -v",
    "lint": "eslint . && prettier --check . && python -m ruff check python-engine && python -m ruff format --check python-engine && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format": "prettier --write . && python -m ruff check --fix python-engine && python -m ruff format python-engine && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "build:engine": "node scripts/build-engine.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-engine.mjs && tauri build --config src-tauri/tauri.bundle.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
}
